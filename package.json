{
  "name": "omelet-expression-trainer",
  "version": "1.0.0",
  "description": "omelet-表达训练系统 - 本地桌面表达训练工具",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "dev": "node scripts/start-electron.js --dev",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.js",
    "dist": "electron-builder --dir",
    "pack": "electron-builder"
  },
  "keywords": [
    "expression",
    "training",
    "speech",
    "asr",
    "chinese"
  ],
  "author": "sisi",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.0",
    "sherpa-onnx-node": "^1.10.0"
  },
  "build": {
    "appId": "com.omelet.expression-trainer",
    "productName": "omelet-表达训练系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!models/**",
      "!**/models/sherpa-onnx-*/**",
      "!dist/**",
      "!docs/**",
      "!demo-*.html",
      "!prompt-playground.html"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
